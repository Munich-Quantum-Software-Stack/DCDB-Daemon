# Python-generated files
__pycache__/
*.py[oc]
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Datasets
datasets/
*.h5

# VScode settings
.vscode

# Secrets
.env

# MAC stuff
.DS_Store

# influxdb vendored source and deps
utils/influxdb-c-client/influxdb-cxx/
utils/influxdb-c-client/cpr/

# Runtime config and credential files (use config-example.json as template)
config.json
examples/**/influxdb_credentials
examples/**/build/

# Third-party dependencies — keep only the helper scripts
extern/*
!extern/clone.sh
!extern/build.sh

# Build artifacts — shell scripts are kept via the exception below
build/*
!build/*.sh

# Logs and temporary files
logs/
